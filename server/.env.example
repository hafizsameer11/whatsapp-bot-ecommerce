# ---------- Server ----------
PORT=3000
# Public HTTPS URL of this server (ngrok / cloudflared). Needed so WhatsApp can fetch product images.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string

# First admin account (created by `npm run setup` / seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ---------- Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret. Used to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=my-verify-token
GRAPH_API_VERSION=v23.0

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Model can also be changed from the admin panel (AI Settings)
OPENAI_MODEL=gpt-4.1-mini

# ---------- Image storage (optional) ----------
# Leave S3_BUCKET empty to store photos in server/uploads on this PC (fine for testing).
# For going live use Cloudflare R2 / AWS S3 / any S3-compatible bucket with public read access:
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com   (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://cdn.yourshop.pk
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
